# MongoDB connection configuration (do not commit production secrets)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=trakloop

# Cryptographically secure server secrets (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-48-byte-base64url-secret
SESSION_SECRET=replace-with-a-random-48-byte-base64url-secret

# Environment
NODE_ENV=development
