# MongoDB connection configuration (do not commit production secrets)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=trakloop

# Cryptographically secure server secrets (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-48-byte-base64url-secret
SESSION_SECRET=replace-with-a-random-48-byte-base64url-secret

# Public application origin used for CSRF validation
APP_URL=http://localhost:3000

# OTP delivery: use console locally; use twilio or webhook in production
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
SMS_WEBHOOK_URL=

# Required when SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Environment
NODE_ENV=development
